# Copy this file to .env and fill in the values. PUBLIC_ vars are visible in the browser (that is expected for these).
# Web3Forms access key (free at https://web3forms.com - enter your email, get the key)
PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable analytics)
PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification content value (leave empty until you have it)
PUBLIC_GSC_VERIFICATION=
