---
export interface Crumb {
  name: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const all: Crumb[] = [{ name: 'Home', href: '/' }, ...crumbs];
---

<nav aria-label="Breadcrumb" class="mb-5 text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-soft">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-2">
          {i < all.length - 1 ? (
            <>
              <a href={c.href} class="inline-flex min-h-6 items-center underline-offset-4 hover:text-brand-dark hover:underline">
                {c.name}
              </a>
              <span aria-hidden="true">/</span>
            </>
          ) : (
            <span aria-current="page" class="font-semibold text-ink">
              {c.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
