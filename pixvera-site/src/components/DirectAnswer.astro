---
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'Quick answer' } = Astro.props;
---

<aside class="mt-6 max-w-3xl rounded-2xl border border-indigo-100 bg-brand-tint p-5 shadow-soft" data-direct-answer>
  <p class="text-xs font-bold uppercase tracking-widest text-brand-dark">{label}</p>
  <p class="mt-2 text-[1.05rem] leading-relaxed text-ink" data-direct-answer-text>{text}</p>
</aside>
