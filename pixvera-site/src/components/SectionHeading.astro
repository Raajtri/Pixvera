---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  center?: boolean;
  as?: 'h2' | 'h3';
}
const { eyebrow, title, text, center = false, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag class="text-3xl sm:text-4xl">{title}</Tag>
  {text && <p class="mt-4 text-lg text-ink-soft">{text}</p>}
</div>
