---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  aria-label="Chat with AceGrow on WhatsApp"
  class="fixed bottom-4 right-4 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-wa text-white shadow-lg shadow-black/25 transition-transform hover:scale-105 sm:bottom-6 sm:right-6"
>
  <Icon name="whatsapp" size={30} />
</a>
