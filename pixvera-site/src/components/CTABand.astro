---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
}
const {
  title = 'Not sure where you stand on Google?',
  text = 'Send us your business name and area. We will check your Google listing and tell you, in plain words, what to fix first. It is free and there is no pressure.',
  primaryLabel = 'Get a Free Google Listing Check',
} = Astro.props;
---

<section class="on-dark relative overflow-hidden bg-ink">
  <div class="pixel-grid-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="blob blob-indigo -left-20 -top-20 h-80 w-80" aria-hidden="true"></div>
  <div class="blob blob-orange -bottom-24 right-0 h-80 w-80" aria-hidden="true"></div>
  <div class="wrap relative py-16 text-center md:py-20">
    <h2 class="mx-auto max-w-2xl text-3xl text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">{text}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/contact/" class="btn btn-primary w-full sm:w-auto">{primaryLabel}</a>
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-wa w-full sm:w-auto">
        <Icon name="whatsapp" size={20} /> Chat on WhatsApp
      </a>
    </div>
  </div>
</section>
