---
/** Pixvera wordmark with a 4-square pixel-grid icon (one square orange). Used in header, footer and favicon. */
interface Props {
  dark?: boolean;
  descriptor?: boolean;
}
const { dark = false, descriptor = true } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true" class="flex-none">
    <rect x="2" y="2" width="12" height="12" rx="3" fill="#4F46E5"></rect>
    <rect x="18" y="2" width="12" height="12" rx="3" fill="#818CF8"></rect>
    <rect x="2" y="18" width="12" height="12" rx="3" fill={dark ? '#A5B4FC' : '#312E81'}></rect>
    <rect x="18" y="18" width="12" height="12" rx="3" fill="#FF7A1A"></rect>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-heading text-[1.4rem] font-extrabold tracking-tight', dark ? 'text-white' : 'text-ink']}>Pixvera</span>
    {
      descriptor && (
        <span class:list={['mt-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em]', dark ? 'text-indigo-200' : 'text-ink-soft']}>
          Digital Growth Studio
        </span>
      )
    }
  </span>
</span>
