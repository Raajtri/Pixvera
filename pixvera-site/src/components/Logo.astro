---
/** AceGrow logo: the "A + growth arrow" symbol with a live-text wordmark (ACE in blue, GROW in dark). Used in header and footer. */
import { Image } from 'astro:assets';
import icon from '../assets/logo-icon.png';

interface Props {
  dark?: boolean;
  descriptor?: boolean;
}
const { dark = false, descriptor = true } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <Image src={icon} alt="" width={92} height={68} loading="eager" class="h-[34px] w-auto flex-none" />
  <span class="flex flex-col leading-none">
    <span class="font-heading text-[1.4rem] font-extrabold uppercase tracking-tight">
      <span class={dark ? 'text-[#5B8DFF]' : 'text-[#0B4DFF]'}>Ace</span><span class={dark ? 'text-white' : 'text-ink'}>Grow</span>
    </span>
    {
      descriptor && (
        <span class:list={['mt-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em]', dark ? 'text-indigo-200' : 'text-ink-soft']}>
          Digital Growth Studio
        </span>
      )
    }
  </span>
</span>
