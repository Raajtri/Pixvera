---
import Icon from './Icon.astro';
interface Props {
  faqs: readonly { q: string; a: string }[];
  heading?: string;
  id?: string;
}
const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section id={id} class="section">
  <div class="wrap max-w-3xl">
    <h2 class="text-3xl sm:text-4xl">{heading}</h2>
    <div class="mt-8 space-y-3">
      {
        faqs.map((f) => (
          <details class="group card !p-0 open:border-indigo-200">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-heading text-[1.05rem] font-bold text-ink [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <Icon name="chevron" class="flex-none text-brand transition-transform group-open:rotate-180" />
            </summary>
            <p class="px-5 pb-5 text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
