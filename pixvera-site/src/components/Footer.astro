---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, services, nav, isPlaceholder, whatsappLink } from '../data/site';
import { liveAreas } from '../data/areas';

const year = new Date().getFullYear();
const social = site.social.filter((s) => !isPlaceholder(s.url));
const hasAreas = liveAreas().length > 0;
---

<footer class="on-dark relative mt-0 overflow-hidden bg-ink text-slate-300">
  <div class="pixel-grid-dark pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="wrap relative py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <a href="/"><Logo dark /></a>
        <p class="mt-4 max-w-xs text-sm text-slate-300">{site.tagline}</p>
        <p class="mt-4 text-sm text-slate-300">
          Serving businesses across {site.serviceAreas.join(', ')}.
        </p>
      </div>

      <nav aria-label="Services">
        <h2 class="font-heading text-base font-bold text-white">Services</h2>
        <ul class="mt-4 space-y-1 text-sm">
          {
            services.map((s) => (
              <li>
                <a class="inline-block py-1.5 hover:text-white" href={`/services/${s.slug}/`}>
                  {s.name}
                </a>
              </li>
            ))
          }
          <li><a class="inline-block py-1.5 hover:text-white" href="/pricing/">Pricing</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="font-heading text-base font-bold text-white">Company</h2>
        <ul class="mt-4 space-y-1 text-sm">
          {
            nav
              .filter((n) => n.href !== '/services/')
              .map((n) => (
                <li>
                  <a class="inline-block py-1.5 hover:text-white" href={n.href}>
                    {n.label}
                  </a>
                </li>
              ))
          }
          {hasAreas && <li><a class="inline-block py-1.5 hover:text-white" href="/areas/">Areas we serve</a></li>}
          <li><a class="inline-block py-1.5 hover:text-white" href="/privacy/">Privacy Policy</a></li>
          <li><a class="inline-block py-1.5 hover:text-white" href="/terms/">Terms</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="font-heading text-base font-bold text-white">Talk to us</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a class="inline-flex items-center gap-2 py-1 hover:text-white" href={whatsappLink()} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> WhatsApp: {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a
              class="inline-flex items-center gap-2 py-1 hover:text-white"
              href={isPlaceholder(site.email) ? '/contact/' : `mailto:${site.email}`}
            >
              <Icon name="mail" size={18} /> {site.email}
            </a>
          </li>
          {
            social.map((s) => (
              <li>
                <a class="inline-block py-1 hover:text-white" href={s.url} rel="noopener me" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact/" class="btn btn-primary btn-sm mt-5">Free Google Listing Check</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-slate-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>{site.descriptor} · {site.location}</p>
    </div>
  </div>
</footer>
