---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DirectAnswer from '../components/DirectAnswer.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Icon from '../components/Icon.astro';
import { seoFor } from '../data/seo';
import { industries } from '../data/industries';
import type { Industry } from '../data/industries';
import { services as serviceSummaries, whatsappLink } from '../data/site';

/** ONE reusable layout for every /industries/[slug]/ page. Edit content in src/data/industries.ts. */
interface Props {
  industry: Industry;
}
const { industry } = Astro.props;

const path = `/industries/${industry.slug}/`;
const seo = seoFor(path);
const crumbs = [
  { name: 'Industries', href: '/industries/' },
  { name: industry.name, href: path },
];

const related = industry.related
  .map((slug) => industries.find((i) => i.slug === slug))
  .filter((i): i is Industry => Boolean(i))
  .map((i) => ({ href: `/industries/${i.slug}/`, title: i.name, text: i.cardText }));

const serviceLinks = industry.services
  .map((slug) => serviceSummaries.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---

<BaseLayout seo={seo} crumbs={crumbs} faqs={industry.faqs}>
  <PageHero h1={seo.h1} crumbs={crumbs} eyebrow="Mumbai · Thane · Navi Mumbai">
    <DirectAnswer text={industry.directAnswer} />
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href="/contact/" class="btn btn-primary">Get a Free Google Listing Check</a>
      <a href={whatsappLink(`Hi Pixvera, I run a business in the ${industry.name} space and would like to talk.`)} target="_blank" rel="noopener" class="btn btn-ghost">
        <Icon name="whatsapp" size={20} class="text-wa" /> Ask on WhatsApp
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="prose-pix max-w-3xl">
        <h2>How customers look for {industry.name.toLowerCase()} today</h2>
        <p>{industry.intro}</p>
      </div>

      <h2 class="mt-14 text-3xl">Common problems we see in this kind of business</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {
          industry.painPoints.map((p) => (
            <li class="card reveal">
              <h3 class="text-lg">{p.title}</h3>
              <p class="mt-2 text-ink-soft">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <h2 class="text-3xl">What we would do for your business</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Pixvera is a new studio, so we describe our approach, not past clients. Here is how we would work on the things that matter most for this type of business.
      </p>
      <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          industry.whatWeDo.map((w) => (
            <li class="card reveal">
              <span class="icon-chip mb-3"><Icon name="check" /></span>
              <h3 class="text-lg">{w.title}</h3>
              <p class="mt-2 text-ink-soft">{w.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="card bg-brand-tint">
          <h2 class="text-xl">Searches your customers may make</h2>
          <p class="mt-1 text-sm text-ink-soft">Examples only, to show how people look for businesses like yours.</p>
          <ul class="mt-4 space-y-2">
            {
              industry.exampleSearches.map((s) => (
                <li class="flex items-center gap-2"><Icon name="search" size={18} class="flex-none text-brand" /> <span>"{s}"</span></li>
              ))
            }
          </ul>
        </div>
        <div class="card">
          <h2 class="text-xl">Services we would use</h2>
          <ul class="mt-4 space-y-2">
            {
              serviceLinks.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`} class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand-dark hover:underline">
                    <Icon name={s.icon} size={20} /> {s.name}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/pricing/" class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand-dark hover:underline">
                <Icon name="file" size={20} /> Pricing and plans
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQ faqs={industry.faqs} />
  <RelatedLinks parent={{ href: '/industries/', label: 'all industries' }} items={related} heading="Other businesses we help with" />
  <CTABand />
</BaseLayout>
