---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RankGraphic from '../components/RankGraphic.astro';
import ShotSlot from '../components/ShotSlot.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { seoFor } from '../data/seo';

const seo = seoFor('/case-study/');
const crumbs = [{ name: 'Case Study', href: '/case-study/' }];

const work = [
  {
    icon: 'map-pin',
    title: 'Local SEO',
    text: 'Work to help a site appear for searches near it: the Google Business Profile, local listings and location details.',
  },
  {
    icon: 'zap',
    title: 'Technical SEO',
    text: 'Work on site speed, mobile display, crawl errors and structure, so Google can read and trust the website.',
  },
  {
    icon: 'file',
    title: 'On-page SEO',
    text: 'Work on page titles, headings, descriptions and course pages, so each page clearly matches what people search for.',
  },
  {
    icon: 'users',
    title: 'Content',
    text: 'Helpful pages and articles that answer the questions students and parents search for.',
  },
  {
    icon: 'target',
    title: 'Backlinks',
    text: 'Links from relevant, trustworthy websites that give Google more reasons to rank a site.',
  },
];

const results = [
  { label: 'Main searches tracked', value: '[MAIN SEARCH 1], [MAIN SEARCH 2]' },
  { label: 'Starting rank', value: '[STARTING RANK]' },
  { label: 'Ending rank', value: '[ENDING RANK]' },
  { label: 'Organic traffic change', value: '[TRAFFIC CHANGE]' },
  { label: 'Enquiries / leads change', value: '[LEADS CHANGE]' },
  { label: 'Time taken', value: '[TIMEFRAME]' },
];
---

<BaseLayout seo={seo} crumbs={crumbs}>
  <PageHero
    h1={seo.h1}
    crumbs={crumbs}
    lead="Our founder took a Mumbai college's website from #3 to #1 on Google for its main searches. Here is what that work looked like."
  >
    <p class="mt-6 inline-flex max-w-2xl items-start gap-2 rounded-2xl border border-indigo-100 bg-brand-tint px-4 py-3 text-[0.95rem]">
      <Icon name="alert" size={22} class="mt-0.5 flex-none text-brand" />
      <span><strong>Please note:</strong> this example is from our founder's previous role. It is not a Pixvera client project, and Pixvera is a new studio. Results vary by business.</span>
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="prose-pix">
        <h2>The situation</h2>
        <p>
          A college in Mumbai had a website that ranked <strong>third</strong> on Google for its main searches. That meant two other results appeared above it. [ADD 1-2 SENTENCES: the starting problem, for example what was missing from the website or the Google listing.]
        </p>
        <h2>The goal</h2>
        <p>
          Move the college to the first position for the searches that matter most.
        </p>
      </div>
      <aside class="card">
        <h2 class="text-lg">At a glance</h2>
        <dl class="mt-4 space-y-3 text-[0.95rem]">
          <div><dt class="font-semibold text-ink-soft">Type of client</dt><dd>A college in Mumbai [ADD COLLEGE NAME ONLY IF YOU HAVE PERMISSION]</dd></div>
          <div><dt class="font-semibold text-ink-soft">Result for main searches</dt><dd>From #3 to #1 on Google</dd></div>
          <div><dt class="font-semibold text-ink-soft">Work done by</dt><dd>[FOUNDER NAME], in a previous role</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading eyebrow="What we did" title="Five areas of work" text="These are the five areas the work covered. Add your specific actions in the orange brackets so the page is concrete and honest." />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          work.map((w) => (
            <li class="card reveal">
              <span class="icon-chip"><Icon name={w.icon} /></span>
              <h3 class="mt-4 text-xl">{w.title}</h3>
              <p class="mt-2 text-ink-soft">{w.text}</p>
              <p class="mt-3 text-sm"><span class="placeholder-tag">[ADD 1-2 SPECIFIC ACTIONS YOU TOOK]</span></p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Results" title="From #3 to #1 on Google" text="The rank jump is shown below. Fill in the other numbers only with figures you can prove." />
      <div class="mt-10 grid items-start gap-10 lg:grid-cols-2">
        <div class="card reveal !p-8">
          <RankGraphic />
        </div>
        <div class="card reveal">
          <h3 class="text-xl">Numbers to confirm</h3>
          <dl class="mt-4 divide-y divide-line">
            {
              results.map((r) => (
                <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
                  <dt class="font-semibold text-ink-soft">{r.label}</dt>
                  <dd class="sm:text-right"><span class="placeholder-tag">{r.value}</span></dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-sm text-ink-soft">Orange items are placeholders. Replace each with a real, checkable number, or remove the row.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading eyebrow="Proof" title="Screenshots" text="Add screenshots of the before and after rankings and the traffic graph. Hide any private details first." />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <ShotSlot label="Google search result BEFORE (rank #3)" />
        <ShotSlot label="Google search result AFTER (rank #1)" />
        <ShotSlot label="Google Search Console performance graph" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap max-w-3xl prose-pix">
      <h2>What this means for your business</h2>
      <p>
        Every business is different, and we cannot promise the same result for you. What we can promise is the same careful approach: check what is holding you back, fix the basics properly, build helpful pages and track the enquiries that follow. If you want to know where you stand today, the first step is free.
      </p>
      <p>
        <a href="/contact/" class="btn btn-primary">Get a Free Google Listing Check</a>
      </p>
    </div>
  </section>

  <RelatedLinks
    parent={{ href: '/services/', label: 'services' }}
    items={[
      { href: '/services/local-seo-mumbai/', title: 'Local SEO services', text: 'Be found on Google Search and Google Maps.' },
      { href: '/industries/schools-colleges-coaching/', title: 'Schools, colleges and coaching', text: 'How we would approach an education business.' },
      { href: '/blog/how-long-does-seo-take-for-a-local-business/', title: 'How long does SEO take?', text: 'What to expect in the first months.' },
    ]}
  />
  <CTABand />
</BaseLayout>
