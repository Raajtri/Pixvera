---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RankGraphic from '../components/RankGraphic.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { seoFor } from '../data/seo';

const seo = seoFor('/case-study/');
const crumbs = [{ name: 'Case Study', href: '/case-study/' }];

/** Problems found at the start of the project. Source: Aman Tripathi's own account of the work. */
const problems = [
  'The home page took about 22 to 27 seconds to load',
  'Heavy images and video, with no lazy loading, slowed every page',
  'A lot of unused CSS and unnecessary code, and a messy site structure',
  'No sitemap and no robots.txt file',
  'Many pages had no index tag telling Google they could be indexed',
  'Many broken links',
  'No clean page URLs (slugs) and weak heading structure',
  'The official logo was not set up to appear in Google results',
  'Keywords on the pages were weak and not well researched',
  'Only about 30 to 40 visits a month to the website',
];

const work: { icon: string; title: string; items: string[]; todo?: string }[] = [
  {
    icon: 'zap',
    title: 'Technical SEO and site structure',
    items: [
      'Cleaned up the site structure and removed unnecessary and unused code and CSS',
      'Created a sitemap and a robots.txt file',
      'Added index tags so the right pages could be indexed',
      'Found and fixed the broken links',
      'Set the official logo so it shows in Google search results',
    ],
  },
  {
    icon: 'clock',
    title: 'Speed and page loading',
    items: [
      'Fixed image properties and optimised heavy images and video',
      'Added lazy loading so images and video load only when needed',
      'Improved the time to first paint, so visitors see the page sooner',
      'Brought the home page load time from about 22 to 27 seconds down to about 7 to 10 seconds',
    ],
  },
  {
    icon: 'search',
    title: 'Keywords and on-page SEO',
    items: [
      'Researched keywords using Semrush and other tools',
      'Improved keyword quality on the web pages',
      'Added clean URL slugs and a proper heading structure',
      'Optimised each page to load faster and read better',
    ],
  },
  {
    icon: 'target',
    title: 'Off-page SEO',
    items: [
      'Found and removed bad links pointing to the website, so they would not hurt its trust with Google',
      "Set up and improved the college's social profiles, linked back to the website",
    ],
  },
  {
    icon: 'chart',
    title: 'Measuring and improving',
    items: [
      'Used Google Analytics to track traffic and bounce rate',
      'Used what the data showed to improve the quality of weak pages',
    ],
  },
];

const results: { label: string; before?: string; after?: string; todo?: string }[] = [
  { label: 'Google rank for its main searches', before: '#3', after: '#1' },
  { label: 'Home page load time', before: 'About 22 to 27 seconds', after: 'About 7 to 10 seconds' },
  { label: 'Website traffic', before: 'About 30 to 40 visits per month', after: 'About 300 to 400 visits per month' },
  { label: 'Time taken', before: 'Start of the project', after: 'About 3 months later' },
];
---

<BaseLayout seo={seo} crumbs={crumbs}>
  <PageHero
    h1={seo.h1}
    crumbs={crumbs}
    lead="In Aman Tripathi's first job, our founder worked on a Mumbai college's website. It was slow, hard for Google to read and hardly visited. Here is what was found, what was fixed and what changed."
  >
    <p class="mt-6 inline-flex max-w-2xl items-start gap-2 rounded-2xl border border-indigo-100 bg-brand-tint px-4 py-3 text-[0.95rem]">
      <Icon name="alert" size={22} class="mt-0.5 flex-none text-brand" />
      <span>
        <strong>Please note:</strong> this work was done in Aman's first job, before AceGrow. It is not an AceGrow client project, and AceGrow is a new studio. This case study covers organic SEO and website work only. Results vary by business.
      </span>
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="prose-pix">
        <h2>The situation</h2>
        <p>
          A college in Mumbai had a website that ranked <strong>third</strong> on Google for its main searches, so two other results appeared above it. The bigger problem was the website itself. It was slow, heavy and poorly organised, and Google was not being told clearly which pages to show.
        </p>
        <p>
          The website was full of large images and video, and nothing was set to load only when needed. Visitors waited around 22 to 27 seconds for the home page, and most people do not wait that long. Traffic was only about 30 to 40 visits a month.
        </p>
        <h2>The goal</h2>
        <p>
          Move the college to the first position for the searches that matter most, make the website fast and easy for Google to understand, and bring in more visitors.
        </p>
      </div>
      <aside class="card">
        <h2 class="text-lg">At a glance</h2>
        <dl class="mt-4 space-y-3 text-[0.95rem]">
          <div><dt class="font-semibold text-ink-soft">Type of client</dt><dd>A college in Mumbai (name not shared, see below)</dd></div>
          <div><dt class="font-semibold text-ink-soft">Result for main searches</dt><dd>From #3 to #1 on Google</dd></div>
          <div><dt class="font-semibold text-ink-soft">Work done by</dt><dd>Aman Tripathi, in a first job</dd></div>
          <div><dt class="font-semibold text-ink-soft">Tools used</dt><dd>Semrush and similar keyword tools, Google Analytics</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading eyebrow="What was wrong" title="What was found at the start" text="A first look showed problems with speed, structure and search set-up." />
      <ul class="mt-10 grid gap-3 md:grid-cols-2">
        {
          problems.map((p) => (
            <li class="reveal flex gap-3 rounded-2xl border border-line bg-paper p-4">
              <Icon name="x" size={20} class="mt-0.5 flex-none text-accent-dark" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="What was done" title="Five areas of work" text="Fixing the basics first, then the keywords, then the measurement." />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          work.map((w) => (
            <li class="card reveal">
              <span class="icon-chip"><Icon name={w.icon} /></span>
              <h3 class="mt-4 text-xl">{w.title}</h3>
              <ul class="mt-3 space-y-2.5 text-[0.95rem] text-ink-soft">
                {w.items.map((t) => (
                  <li class="flex gap-2.5"><Icon name="check" size={18} class="mt-0.5 flex-none text-brand" /><span>{t}</span></li>
                ))}
              </ul>
              {w.todo && <p class="mt-3 text-sm"><span class="placeholder-tag">{w.todo}</span></p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading eyebrow="Results" title="From #3 to #1 on Google" text="These numbers come from Aman's own account of the project." />
      <div class="mt-10 grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="card reveal !p-8">
          <RankGraphic />
        </div>
        <div class="card reveal overflow-hidden !p-0">
          <table class="w-full text-left text-[0.95rem]">
            <caption class="sr-only">Before and after results</caption>
            <thead class="bg-slate-50 text-sm text-ink-soft">
              <tr>
                <th scope="col" class="p-4 font-semibold">What changed</th>
                <th scope="col" class="p-4 font-semibold">Before</th>
                <th scope="col" class="p-4 font-semibold">After</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                results.map((r) => (
                  <tr>
                    <th scope="row" class="p-4 font-semibold">{r.label}</th>
                    {r.before ? (
                      <>
                        <td class="p-4 text-ink-soft">{r.before}</td>
                        <td class="p-4 font-semibold text-brand-dark">
                          {r.after}
                          {r.todo && <span class="mt-1 block"><span class="placeholder-tag">{r.todo}</span></span>}
                        </td>
                      </>
                    ) : (
                      <td colspan="2" class="p-4"><span class="placeholder-tag">{r.todo}</span></td>
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-sm text-ink-soft">
        Load time was measured on the home page, which had the heaviest content, and traffic was tracked in Google Analytics. A load time of 7 to 10 seconds is still not fast, because this website was image-heavy and used video. On a lighter website we aim much lower.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap max-w-3xl">
      <div class="card reveal bg-brand-tint">
        <h2 class="text-xl">Why there is no college name or screenshots</h2>
        <p class="mt-3 text-ink-soft">
          The college asked not to be named, and its analytics and ranking data are private. So we do not show its name, graphs or screenshots. If you would like to know more about how the work was done, ask us on a call and we will explain it in detail.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap prose-pix max-w-3xl">
      <h2>What this means for your business</h2>
      <p>Every business is different, and we cannot promise the same result for you. But the lessons carry over:</p>
      <ul>
        <li><strong>Speed matters.</strong> Heavy images and video with no lazy loading can make a website painfully slow, and visitors leave.</li>
        <li><strong>The basics matter.</strong> A sitemap, a robots.txt file, index tags, working links and clean URLs help Google understand your website.</li>
        <li><strong>Measure what happens.</strong> Google Analytics shows where visitors drop off, so the right pages get fixed.</li>
      </ul>
      <p>If you want to know where your own website stands, the first step is free.</p>
      <p><a href="/contact/" class="btn btn-primary">Get a Free Google Listing Check</a></p>
    </div>
  </section>

  <RelatedLinks
    parent={{ href: '/services/', label: 'services' }}
    items={[
      { href: '/services/local-seo-mumbai/', title: 'Local SEO services', text: 'Be found on Google Search and Google Maps.' },
      { href: '/industries/schools-colleges-coaching/', title: 'Schools, colleges and coaching', text: 'How we would approach an education business.' },
      { href: '/blog/how-long-does-seo-take-for-a-local-business/', title: 'How long does SEO take?', text: 'What to expect in the first months.' },
    ]}
  />
  <CTABand />
</BaseLayout>
