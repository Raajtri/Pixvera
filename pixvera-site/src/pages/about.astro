---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { seoFor } from '../data/seo';
import { site } from '../data/site';

const seo = seoFor('/about/');
const crumbs = [{ name: 'About', href: '/about/' }];

const values = [
  { icon: 'shield', title: 'Honest about results', text: 'We never promise rankings. We show you what we did and what changed.' },
  { icon: 'users', title: 'Plain language', text: 'No jargon. If you cannot understand our report, we have not done our job.' },
  { icon: 'target', title: 'Enquiries over vanity', text: 'We care about calls, messages and customers, not just clicks and likes.' },
];
---

<BaseLayout seo={seo} crumbs={crumbs}>
  <PageHero
    h1={seo.h1}
    crumbs={crumbs}
    lead="Pixvera is a new digital growth studio, started by two founders who want local businesses to be found online and contacted easily."
  />

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="prose-pix">
        <h2>Our story</h2>
        <p>
          Pixvera was started in Mumbai by two founders, {site.founders[0].name} and {site.founders[1].name} {site.founderSurname}. [ADD YOUR STORY IN 3-4 SHORT PARAGRAPHS: why you started Pixvera, what you saw small businesses struggling with, and what you want to do differently.]
        </p>
        <p>
          Before Pixvera, one of us worked on SEO for a college in Mumbai and took its website from the third position on Google to the first for its main searches. You can read what that work involved in our <a href="/case-study/">case study</a>. It is the only result we show, because it is the only one that is ours to show.
        </p>
        <h2>We are new, and we say so</h2>
        <p>
          Pixvera is a young studio. We do not have a long list of clients to show you, and we will not make one up. What we do have is hands-on experience, a careful process and a promise to be straight with you about what will and will not work for your business.
        </p>
        <h2>Who we work with</h2>
        <p>
          Shops, restaurants, clinics, salons, schools, colleges, gyms, real estate, professional services, startups and more across Mumbai, Thane and Navi Mumbai. If you need to be found on Google and contacted by customers, we can probably help. If we cannot, we will tell you.
        </p>
      </div>

      <div class="grid gap-5 content-start sm:grid-cols-2 lg:grid-cols-1">
        {
          site.founders.map((f) => (
            <div class="card reveal flex items-start gap-4">
              <div
                class="flex h-24 w-24 flex-none items-center justify-center rounded-2xl border-2 border-dashed border-indigo-300 bg-brand-tint text-center text-xs font-semibold text-brand-dark"
                role="img"
                aria-label={`Photo placeholder for ${f.name}`}
              >
                [PHOTO]
              </div>
              <div>
                <h3 class="text-xl">{f.name} {site.founderSurname}</h3>
                <p class="text-sm font-semibold text-brand-dark">{f.role}, Pixvera</p>
                <p class="mt-2 text-sm text-ink-soft">{f.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading eyebrow="What we believe" title="How we work" center />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          values.map((v) => (
            <li class="card reveal">
              <span class="icon-chip"><Icon name={v.icon} /></span>
              <h3 class="mt-4 text-xl">{v.title}</h3>
              <p class="mt-2 text-ink-soft">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <RelatedLinks
    parent={{ href: '/', label: 'home' }}
    items={[
      { href: '/services/', title: 'Our services', text: 'Local SEO, websites, ads and apps for Mumbai businesses.' },
      { href: '/case-study/', title: 'Case study', text: 'How a college website went from #3 to #1 on Google.' },
      { href: '/contact/', title: 'Contact us', text: 'Ask for a free Google listing check.' },
    ]}
  />
  <CTABand />
</BaseLayout>
