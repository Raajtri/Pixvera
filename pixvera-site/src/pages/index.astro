---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RankGraphic from '../components/RankGraphic.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { seoFor } from '../data/seo';
import { services, pricing } from '../data/site';
import { industries } from '../data/industries';
import { homeFaqs } from '../data/faqs';

const seo = seoFor('/');

const problems = [
  {
    icon: 'search',
    problem: 'Customers cannot find you',
    solution: 'We fix your Google Business Profile and local SEO so you show up on Google Search and Maps when people nearby look for what you sell.',
  },
  {
    icon: 'layout',
    problem: 'Your website does not bring enquiries',
    solution: 'We build a fast, mobile-friendly website with clear pages, a contact form and a WhatsApp button, so visitors can reach you in one tap.',
  },
  {
    icon: 'chart',
    problem: 'Ad money goes in, results are unclear',
    solution: 'We set up tracking first. You see calls, forms and WhatsApp messages, not just clicks, and we adjust every week.',
  },
];

const steps = [
  { title: 'Audit', text: 'We check your Google listing, website and competitors, then tell you what to fix first.' },
  { title: 'Setup', text: 'We build or fix your profile, website, tracking and WhatsApp lead flow.' },
  { title: 'Launch', text: 'Your pages and campaigns go live. We test everything on real phones.' },
  { title: 'Report', text: 'Every month you get a simple report on enquiries and the next steps.' },
];
---

<BaseLayout seo={seo} faqs={homeFaqs}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-white">
    <div class="pixel-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="blob blob-indigo -right-28 -top-28 h-80 w-80 sm:h-[34rem] sm:w-[34rem]" aria-hidden="true"></div>
    <div class="blob blob-orange -bottom-32 -left-24 h-72 w-72 sm:h-[28rem] sm:w-[28rem]" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-10 py-12 md:py-20 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="eyebrow mb-4">Digital Growth Studio · Mumbai</p>
        <h1 class="text-[2.35rem] leading-[1.08] sm:text-6xl">{seo.h1}</h1>
        <p class="mt-5 max-w-xl text-lg text-ink-soft sm:text-xl">
          Whatever your business sells, AceGrow builds your website, gets you found on Google and Maps, and turns searches into customers. We serve businesses across Mumbai, Thane and Navi Mumbai.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="btn btn-primary">Get a Free Google Listing Check</a>
          <a href="/case-study/" class="btn btn-ghost">See Our Results</a>
        </div>
        <p class="mt-6 inline-flex max-w-xl items-start gap-2 rounded-2xl border border-indigo-100 bg-brand-tint px-4 py-3 text-[0.95rem] text-ink">
          <Icon name="target" size={22} class="mt-0.5 flex-none text-brand" />
          <span><strong>Our founder Aman Tripathi took a Mumbai college website from #3 to #1 on Google</strong>, in a first job.</span>
        </p>
      </div>
      <div class="hidden lg:block">
        <div class="card !p-8">
          <RankGraphic />
        </div>
      </div>
    </div>
  </section>

  <!-- Problem to solution -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Sound familiar?"
        title="Three problems we fix for businesses of every kind"
        text="Most owners we speak to are good at their work. The trouble is that customers cannot find them, or cannot easily contact them."
      />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          problems.map((p, i) => (
            <li class="card reveal" style={`--d:${i * 90}ms`}>
              <span class="icon-chip"><Icon name={p.icon} /></span>
              <h3 class="mt-4 text-xl">{p.problem}</h3>
              <p class="mt-3 text-ink-soft">{p.solution}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading
        eyebrow="What we do"
        title="Everything you need to get found and get contacted"
        text="Pick one service or combine them. We will suggest what fits your budget."
      />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li class="reveal" style={`--d:${i * 70}ms`}>
              <a href={`/services/${s.slug}/`} class="card flex h-full flex-col">
                <span class="icon-chip"><Icon name={s.icon} /></span>
                <h3 class="mt-4 text-xl">{s.name}</h3>
                <p class="mt-2 flex-1 text-ink-soft">{s.short}</p>
                <span class="mt-4 inline-flex items-center gap-1 font-semibold text-brand-dark">
                  Learn more <Icon name="arrow-right" size={18} />
                </span>
              </a>
            </li>
          ))
        }
        <li class="reveal">
          <div class="card flex h-full flex-col justify-center bg-ink !text-white" style="background:#0B1B3A;border-color:#0B1B3A">
            <h3 class="text-xl !text-white">Not sure what you need?</h3>
            <p class="mt-2 text-slate-300">Start with a free Google listing check. We will point out the one or two things worth fixing first.</p>
            <a href="/contact/" class="btn btn-primary mt-5 self-start">Book your check</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Industries -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Businesses we help"
        title="Built for every kind of business"
        text="Choose your type of business to see how we would approach it. If it is not listed, we still work with you."
      />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          industries.map((ind, i) => (
            <li class="reveal" style={`--d:${(i % 3) * 70}ms`}>
              <a href={`/industries/${ind.slug}/`} class="card flex h-full items-start gap-4 !p-5">
                <span class="icon-chip"><Icon name={ind.icon} /></span>
                <span>
                  <span class="block font-heading text-lg font-bold">{ind.name}</span>
                  <span class="mt-1 block text-sm text-ink-soft">{ind.cardText}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-ink-soft">
        Do not see your business? <a href="/industries/#all-industries" class="font-semibold text-brand-dark underline">We work with all industries. Talk to us.</a>
      </p>
    </div>
  </section>

  <!-- Case study teaser -->
  <section class="section on-dark relative overflow-hidden bg-ink">
    <div class="pixel-grid-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow eyebrow-dark mb-3">Case study</p>
        <h2 class="text-3xl text-white sm:text-4xl">A Mumbai college, from #3 to #1 on Google</h2>
        <p class="mt-4 text-lg text-slate-300">
          In a first job, our founder Aman Tripathi worked on a slow, heavy college website that ranked third on Google. After fixing its speed, structure and keywords, it reached first place, and its traffic grew roughly ten times.
        </p>
        <p class="mt-3 text-slate-300">See the full list of problems, fixes and results on the case study page.</p>
        <a href="/case-study/" class="btn btn-primary mt-7">Read the case study</a>
      </div>
      <div class="reveal rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 sm:p-8">
        <RankGraphic compact />
        <p class="mt-5 text-center text-sm text-slate-300">Aman Tripathi's first job, not an AceGrow client project.</p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="How we work" title="A simple 4-step process" center />
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class="card reveal relative" style={`--d:${i * 80}ms`}>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand font-heading font-bold text-white">{i + 1}</span>
              <h3 class="mt-4 text-xl">{s.title}</h3>
              <p class="mt-2 text-ink-soft">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Packages preview -->
  <section class="section bg-white">
    <div class="wrap">
      <SectionHeading
        eyebrow="Packages"
        title="Clear plans, no surprises"
        text="Website packages are one-time. SEO and ads plans are monthly. Ad spend, domain and hosting are paid by you."
      />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          pricing.websites.map((p) => (
            <li class:list={['card reveal', p.highlight && '!border-2 !border-brand shadow-lift']}>
              <h3 class="text-xl">{p.name}</h3>
              <p class="mt-1 text-sm text-ink-soft">{p.blurb}</p>
              <p class="mt-5 font-heading text-2xl font-extrabold">{p.from}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/pricing/" class="btn btn-brand">See all packages and monthly plans</a>
        <a href="/services/mobile-app-development-mumbai/" class="btn btn-ghost">Mobile apps: custom quote</a>
      </div>
    </div>
  </section>

  <FAQ faqs={homeFaqs} />
  <CTABand />
</BaseLayout>
