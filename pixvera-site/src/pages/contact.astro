---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { seoFor } from '../data/seo';
import { site, whatsappLink, isPlaceholder } from '../data/site';

const seo = seoFor('/contact/');
const crumbs = [{ name: 'Contact', href: '/contact/' }];

const checks = [
  'Is your Google Business Profile claimed, complete and using the right categories?',
  'Do your name, phone number and service area match everywhere online?',
  'Do you have photos, services and recent reviews that build trust?',
  'Does your website load fast and work well on a phone?',
  'Where do you appear today for two or three searches your customers use?',
];
---

<BaseLayout seo={seo} crumbs={crumbs}>
  <PageHero
    h1={seo.h1}
    crumbs={crumbs}
    lead="Tell us about your business. We usually reply on WhatsApp first, because that is where most business owners prefer to talk."
  />

  <section class="section">
    <div class="wrap grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <ContactForm />

      <div class="space-y-6">
        <div class="card">
          <h2 class="text-xl">Talk to us directly</h2>
          <ul class="mt-4 space-y-3">
            <li>
              <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-wa w-full">
                <Icon name="whatsapp" size={22} /> WhatsApp: {site.phoneDisplay}
              </a>
            </li>
            <li class="flex items-center gap-3 pt-1">
              <Icon name="mail" class="flex-none text-brand" />
              {
                isPlaceholder(site.email) ? (
                  <span>Email: {site.email}</span>
                ) : (
                  <a href={`mailto:${site.email}`} class="font-semibold text-brand-dark underline">{site.email}</a>
                )
              }
            </li>
            <li class="flex items-center gap-3">
              <Icon name="map-pin" class="flex-none text-brand" />
              <span>Serving {site.serviceAreas.join(', ')}</span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="clock" class="flex-none text-brand" />
              <span>We usually reply within [X] working hours</span>
            </li>
          </ul>
        </div>

        <div class="card bg-brand-tint" id="free-check">
          <h2 class="text-xl">What is the free Google listing check?</h2>
          <p class="mt-3 text-ink-soft">
            It is a quick look at how your business appears on Google and Google Maps. You get a short, plain-language summary of what to fix first. There is no cost and no obligation to hire us.
          </p>
          <h3 class="mt-5 text-base">What we look at</h3>
          <ul class="mt-3 space-y-2.5 text-[0.95rem]">
            {checks.map((c) => <li class="flex gap-2.5"><Icon name="check" size={20} class="mt-0.5 flex-none text-brand" /><span>{c}</span></li>)}
          </ul>
          <h3 class="mt-5 text-base">What we need from you</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">Your business name, your area and your website or Google Maps link, if you have one.</p>
        </div>
      </div>
    </div>
  </section>

  <RelatedLinks
    parent={{ href: '/', label: 'home' }}
    items={[
      { href: '/services/', title: 'Our services', text: 'Local SEO, websites, ads and apps for Mumbai businesses.' },
      { href: '/pricing/', title: 'Pricing', text: 'What affects the cost and what our plans include.' },
      { href: '/blog/how-to-set-up-google-business-profile-step-by-step/', title: 'Set up your Google Business Profile', text: 'A free step-by-step guide you can follow today.' },
    ]}
  />
</BaseLayout>
